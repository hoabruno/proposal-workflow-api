# Local development database started with `npm run db:dev`.
DATABASE_URL="postgresql://atipik:atipik@localhost:54329/atipik"

# Signs session tokens; generate a long random value per environment,
# for instance with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-at-least-32-random-characters"
# Local HTTP only: production keeps the default (Secure cookies).
COOKIE_SECURE="false"

# Allowed origins for state-changing requests, comma-separated. Leave empty
# in local development; production sets https://atipik.middlewa.re.
ALLOWED_ORIGINS=""
